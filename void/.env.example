# Build-time public API addresses; never put secrets in VITE_* variables.
VITE_CATALOG_API_URL=https://api.example.com/api/v1/catalog
VITE_CART_API_URL=https://api.example.com/api/v1/cart
VITE_ACCOUNTS_API_URL=https://api.example.com/api/v1/accounts
VITE_ORDERS_API_URL=https://api.example.com/api/v1/orders
