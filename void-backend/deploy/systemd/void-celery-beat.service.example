[Unit]
Description=VOID Celery Beat scheduler (run exactly one instance)
After=network.target

[Service]
User=void
Group=void
WorkingDirectory=/srv/void/void-backend
EnvironmentFile=/etc/void/void.env
Environment=DJANGO_SETTINGS_MODULE=config.settings.production
StateDirectory=void-celery
ExecStart=/srv/void/venv/bin/celery -A config beat --loglevel=INFO --schedule=/var/lib/void-celery/celerybeat-schedule
Restart=on-failure
RestartSec=5
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
