[Unit]
Description=VOID Django API (Gunicorn)
After=network.target

[Service]
User=void
Group=www-data
WorkingDirectory=/srv/void/void-backend
EnvironmentFile=/etc/void/void.env
Environment=DJANGO_SETTINGS_MODULE=config.settings.production
RuntimeDirectory=void
RuntimeDirectoryMode=0770
UMask=0007
ExecStart=/srv/void/venv/bin/gunicorn config.wsgi:application --workers 3 --timeout 60 --bind unix:/run/void/gunicorn.sock
Restart=on-failure
RestartSec=5
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
