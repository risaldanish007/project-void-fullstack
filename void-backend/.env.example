# Copy to .env for local use. Never commit real credentials.
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=False
DJANGO_SETTINGS_MODULE=config.settings.production
ALLOWED_HOSTS=api.example.com
CORS_ALLOWED_ORIGINS=https://example.com
CSRF_TRUSTED_ORIGINS=https://example.com
DB_NAME=void
DB_USER=void_app
DB_PASSWORD=replace-with-a-unique-database-password
DB_HOST=127.0.0.1
DB_PORT=5432
EMAIL_HOST_USER=replace-with-mailbox@example.com
EMAIL_HOST_PASSWORD=replace-with-mail-app-password
RAZORPAY_KEY_ID=replace-with-live-key-id
RAZORPAY_KEY_SECRET=replace-with-live-key-secret
USD_TO_INR_RATE=83.000000
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
