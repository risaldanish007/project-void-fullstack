# Copy to .env for local use. Never commit real credentials.
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=True
# Production processes must set DJANGO_SETTINGS_MODULE in their process environment.
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DB_NAME=replace-with-database-name
DB_USER=replace-with-database-user
DB_PASSWORD=replace-with-a-unique-database-password
DB_HOST=127.0.0.1
DB_PORT=5432
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=replace-with-mailbox@example.com
EMAIL_HOST_PASSWORD=replace-with-mail-app-password
RAZORPAY_KEY_ID=replace-with-razorpay-key-id
RAZORPAY_KEY_SECRET=replace-with-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-webhook-secret
USD_TO_INR_RATE=83.000000
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CACHE_REDIS_URL=redis://127.0.0.1:6379/1
COOKIE_SAMESITE=Lax
# Leave COOKIE_DOMAIN empty unless all cookie-using hosts share a registrable domain.
COOKIE_DOMAIN=
# Set these to persistent directories in production.
MEDIA_ROOT=media
STATIC_ROOT=staticfiles
